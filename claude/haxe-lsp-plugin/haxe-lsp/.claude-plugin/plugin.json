{
  "name": "haxe-lsp-plugin",
  "description": "Haxe language server for code intelligence in .hx files",
  "version": "0.1.0",
  "author": {
    "name": "vantreeseba"
  },
  "category": "development",
  "strict": false,
  "lspServers": {
    "haxe": {
      "command": "node",
      "args": [
        "/home/vantreeseba/bin/haxe-lsp.js"
      ],
      "extensionToLanguage": {
        ".hx": "haxe"
      },
      "initializationOptions": {
        "displayArguments": [
          "build.hxml"
        ]
      }
    }
  }
}
