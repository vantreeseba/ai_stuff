{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ],
      "initialization": {
        "plugins": [
          {
            "name": "@0no-co/graphqlsp",
            "location": "node_modules"
          }
        ],
        "tsserver": {
          "logVerbosity": "off",
          "useSyntaxServer": "auto"
        }
      }
    }
  }
}
