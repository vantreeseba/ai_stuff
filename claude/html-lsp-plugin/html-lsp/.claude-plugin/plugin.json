{
  "name": "html-lsp-plugin",
  "description": "HTML language server for code intelligence in .html and .htm files via vscode-html-language-server",
  "version": "0.1.0",
  "author": {
    "name": "vantreeseba"
  },
  "category": "development",
  "strict": false,
  "lspServers": {
    "html": {
      "command": "vscode-html-language-server",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".html": "html",
        ".htm": "html"
      }
    }
  }
}
