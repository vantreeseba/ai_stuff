{
  "name": "json-lsp-plugin",
  "description": "JSON language server for code intelligence in .json and .jsonc files via vscode-json-language-server",
  "version": "0.1.0",
  "author": {
    "name": "vantreeseba"
  },
  "category": "development",
  "strict": false,
  "lspServers": {
    "json": {
      "command": "vscode-json-language-server",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".json": "json",
        ".jsonc": "jsonc"
      }
    }
  }
}
